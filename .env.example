# ============================================================================
# MODEL SPACE
#
# Three distinct model roles, two upstreams:
#
#   1. MAIN PUMP  — the agent's own conversation loop, through core.sock.
#      Upstream is configurable: a direct/custom OpenAI-compatible address
#      (LLM_BASE_URL + LLM_API_KEY) or, when LLM_BASE_URL is unset,
#      OpenRouter with OPENROUTER_API_KEY. Model named by LLM_MODEL, in the
#      chosen upstream's own naming scheme.
#
#   2. TEXT STREAM MODELS — models the agent may pin to declared stream
#      sockets for its own sub-calls. Always served through OpenRouter with
#      OPENROUTER_API_KEY, regardless of LLM_BASE_URL. OpenRouter slugs only.
#
#   3. VISION STREAM MODELS — same mechanics as the text list, but these
#      accept image content in messages; models.json marks them image_input
#      so the agent can discover that sight is possible.
#
# All keys land ONLY in the recorder container (the stage's separate key is
# below), never the agent: the recorder injects them at forward time and
# logs bodies, never headers.
# ============================================================================

# --- Main pump -------------------------------------------------------------
# Direct/custom upstream for the pump. Unset = pump uses OpenRouter instead.
# A server on the Docker host at 0.0.0.0:5000 is reachable from the recorder
# as http://host.docker.internal:5000/v1.
#LLM_BASE_URL=https://api.deepseek.com
# Key for that upstream. Leave empty for a no-auth local server.
#LLM_API_KEY=
# Pump model, in the pump upstream's naming (e.g. deepseek-v4-pro direct,
# deepseek/deepseek-v4-pro on OpenRouter).
#LLM_MODEL=deepseek-v4-pro

# --- Streams (and the eye): always OpenRouter ------------------------------
# Real OpenRouter key — used for every declared stream socket, and for the
# pump only when LLM_BASE_URL is unset. With no key here, stream
# declarations are rejected and models.json publishes an empty list.
OPENROUTER_API_KEY=sk-or-...
# OpenRouter slugs a declared stream may pin as its composed model, matched
# exactly, split by modality; the union is the permitted set, published to
# the agent as /llm/sock/models.json with a per-entry image_input flag.
# Both empty permits none: a declaration that names a model is rejected,
# and requests keep the model they were sent with, so a stack shipped with
# these commented out binds no socket at all.
# The console seed the agent's entrypoint writes on a first start declares one
# stream per slug named here (llm_console_seed.json), so the two files carry
# the same model set and a test fails when they drift. Editing a list without
# regenerating the seed leaves a permitted model with no socket. At most eight
# streams bind (MAX_STREAMS); declarations past the eighth are rejected.
STREAM_MODEL_ALLOW_TEXT=deepseek/deepseek-v4-pro-0813,deepseek/deepseek-v4-flash,qwen/qwen3.8-max
STREAM_MODEL_ALLOW_VISION=qwen/qwen3.7-flash

# --- Agent cognition knobs -------------------------------------------------
# Send-time context window in estimated tokens. Set this below the pump
# model's context length so Aurora's windowing decides what is dropped.
#CONTEXT_WINDOW_TOKENS=28000
# Reasoning effort sent with each pump request: none, low, medium, or high.
# Leave unset to omit the field and let the model apply its own default.
# Models that do not support the field may reject requests that carry it.
#REASONING_EFFORT=high

# Path to the unix socket the recorder serves and the agent connects to. Unset
# uses the in-container default. Set it to an empty string to bypass the
# recorder and call the upstream directly, which is only useful outside Docker.
# Compose deliberately passes this to neither service, so setting it here does
# nothing to the stack: an operator cannot empty it and route the agent around
# the recorder. It applies only when running the agent on a bare host.
#LLM_SOCKET_PATH=/llm/sock/core.sock

# --- Stream budgets --------------------------------------------------------
# Two ceilings on each declared model stream, both here rather than in the llm
# console file because the agent can write that file: whatever a declaration
# names, min(declared, ceiling) is enforced, so the console can lower an
# allowance and never raise one. Neither applies to core.sock, the agent's own
# conversation loop, which has no ceiling of any kind and is deliberately left
# that way — the upstream key's budget is its limit, and running that budget
# out is a real consequence rather than a synthetic refusal.
#
# Tokens are the spend limit: total_tokens (prompt plus completion) is what is
# billed, and 2,000,000 an hour is roughly 60-200 turns for an agent running
# full time. Admission happens before the response exists, so a stream can
# overshoot by at most one maximum response.
STREAM_TOKEN_HOURLY_MAX=2000000
# Requests are a rate guard rather than a spend guard: 1200 an hour is one
# every three seconds, so a hot loop cannot hammer the upstream even when each
# call is cheap. The crossover is 2000000 / 1200 = about 1667 tokens per turn —
# larger turns meet the token quota first, smaller ones meet this. Setting it
# much lower makes the token quota unreachable. The code default is 120, low
# for a stream a full-time agent draws on, so the template states 1200 here.
STREAM_HOURLY_MAX=1200
# Tokens added to a composed request's max_tokens when reasoning is on, so a
# declared cap bounds the response rather than being consumed by reasoning.
# Unset keeps the recorder's default of 8192; 0 disables the addition.
#STREAM_REASONING_ALLOWANCE=8192

# --- Stage (its own key, never the recorder's) -----------------------------
# Operator console token for the stage (required to use the console on :8092)
STAGE_CONSOLE_TOKEN=
# Optional narrative recap on the stream page. The stage calls an
# OpenAI-compatible chat-completions endpoint to summarise recent
# incarnations in prose. Leave STAGE_SUMMARY_API_KEY empty to disable the
# feature; it is off by default and the page then derives its recap from
# tombstone text. This key is separate from OPENROUTER_API_KEY: the stage
# never reads the recorder's credential (the same low-value key value may
# be reused, but it arrives through the stage's own environment).
STAGE_SUMMARY_API_KEY=
#STAGE_SUMMARY_BASE_URL=https://openrouter.ai/api/v1
#STAGE_SUMMARY_MODEL=anthropic/claude-sonnet-5
#STAGE_SUMMARY_INTERVAL_SECONDS=300
#STAGE_COMMENTARY_MODEL=anthropic/claude-haiku-4-5-20251001
#STAGE_COMMENTARY_INTERVAL_SECONDS=60
# The analysis desk (star verdicts on dead incarnations) shares the summary
# key; no key, no segment. The model defaults to the summary model and the
# segment duration to 20 seconds.
#STAGE_ANALYSIS_MODEL=anthropic/claude-haiku-4-5-20251001
#STAGE_ANALYSIS_DURATION_SECONDS=20

# --- Speech (diode only) ---------------------------------------------------
# Optional speech for the diode's `speak` command. This key is mounted ONLY
# into the diode container, never the agent: the agent has no network
# interface, and reaches the diode only through a shared volume carrying a
# closed command vocabulary, so it can cause spend through the gated, budgeted
# command but never sees the key. Leave empty to disable the command entirely.
ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
#ELEVENLABS_MODEL=eleven_multilingual_v2
# Both controls on this credential's spend. The agent can write the diode's
# console file, so neither the on-switch nor the ceiling may live there:
# ENABLE_SPEECH (any non-empty value) has to be set before `speak` can exist,
# and SPEECH_HOURLY_MAX caps how many utterances an hour can produce no matter
# what fetch_budget the agent sets. Default ceiling is 20.
ENABLE_SPEECH=
#SPEECH_HOURLY_MAX=20

# --- Diode budget ----------------------------------------------------------
# Ceiling on the diode's shared hourly network-operation budget. The agent can
# write the console's fetch_budget, so the ceiling lives here: the effective
# limit at every budget-charging command is min(fetch_budget, DIODE_HOURLY_MAX),
# and speak additionally respects SPEECH_HOURLY_MAX. Default ceiling is 120.
#DIODE_HOURLY_MAX=120

# --- Process scheduler (agent container) -----------------------------------
# How many entries the scheduler at /pump will hold, and how many of their
# processes may run at once. These are resource hygiene rather than ceilings:
# they exist so the scheduler cannot exhaust the agent container's pids_limit
# or mem_limit by accident, and processes in that container can be started
# without it. Defaults are 32 and 8.
#PUMP_MAX_ENTRIES=32
#PUMP_MAX_CONCURRENT=8

# --- Sense (ambient camera feeds; this service holds no credential) --------
# Public YouTube live streams the sense service captures a frame from each
# interval, as a JSON list; each entry is {"id": <video id>, ["dir": <name>],
# ["vf": <ffmpeg filter>]}. "dir" is the directory under /sense the feed
# writes to and defaults to the entry's position ("0", "1", ...); name it
# explicitly to keep a feed's directory stable while the list is reordered.
# "vf" is an optional capture-time filter (crop a caption band, blur a logo
# box). Any number of entries; unset or [] captures nothing. Grabs are spaced
# evenly across the interval in list order, one feed at a time. Read once at
# start: after editing, `docker compose up -d sense` recreates the sense
# service alone, leaving the agent untouched.
# The template set: Monterey Bay Aquarium sea otters (reference feed, logo
# blurred), Bondi Icebergs pool, Washington Monument, Times Square, New
# Orleans French Quarter, Tamariu (Spain), Western Wall (Jerusalem), Shinjuku
# (Tokyo), Koh Samui beach (Thailand).
SENSE_FEEDS=[{"dir":"3","id":"abbR-Ttd-cA","vf":"scale=1280:-2,delogo=x=910:y=40:w=330:h=80"},{"dir":"0","id":"53ILEi6FMaA"},{"dir":"4","id":"oDCAAfOSqvA"},{"dir":"5","id":"JQ_jwk_7OVE"},{"dir":"6","id":"QhFYcPBmkcI"},{"dir":"7","id":"PMhVgTcDd1o"},{"dir":"8","id":"77akujLn4k8"},{"dir":"9","id":"6dp-bvQ7RWo"},{"dir":"10","id":"kkVrj2cr9Ko"}]
# Minutes between captures, and slots in each feed's ring: 144 x 10 min holds
# one day, after which a slot is overwritten.
#SENSE_INTERVAL_MINUTES=10
#SENSE_RING_SLOTS=144
# Mean 32x32 grayscale pixel difference below which a frame counts as static.
#SENSE_STATIC_THRESHOLD=2.0
# Remove frames older than this many hours each cycle, so nothing older than
# a day remains even when a feed stops and its slots are no longer rewritten.
# 0 keeps every frame until its slot is overwritten.
#SENSE_MAX_AGE_HOURS=24

# --- Public stream ---------------------------------------------------------
# Cloudflare Tunnel connector token for the optional cloudflared service
# (docker compose --profile stream up): it authenticates the tunnel daemon
# to Cloudflare and publishes the stage stream page at the public hostname
# configured in the Cloudflare dashboard. Point that hostname at
# http://stage:8091. Never expose 8092. Leave the profile off (or this
# placeholder value) to keep the stage loopback-only.
TUNNEL_TOKEN=

# --- Host ------------------------------------------------------------------
# Loop image backing /build (mounted by scripts/create_build_volume.sh).
#AURORA_BUILD_IMG=/absolute/path/to/volumes/build.img
