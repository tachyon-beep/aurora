# The recorder forwards to one of two upstreams. Setting LLM_BASE_URL selects
# the OpenAI-compatible mode; leaving it unset selects OpenRouter.

# --- Mode 1: OpenRouter ---
# Real key — mounted ONLY into the recorder container, never the agent.
OPENROUTER_API_KEY=sk-or-...
# Model the agent requests (forwarded by the recorder).
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# --- Mode 2: OpenAI-compatible router ---
# A server bound to 0.0.0.0:5000 on the Docker host is reachable from the
# recorder container as host.docker.internal:5000. For runs outside Docker,
# use http://localhost:5000/v1.
#LLM_BASE_URL=http://host.docker.internal:5000/v1
# Optional key for the upstream server. Leave empty for a no-auth local server.
#LLM_API_KEY=
# Model name sent in chat completion requests. Overrides OPENROUTER_MODEL.
#LLM_MODEL=local-model

# Send-time context window in estimated tokens. Set this below the upstream
# server's context length so Aurora's windowing decides what is dropped.
#CONTEXT_WINDOW_TOKENS=28000

# Path to the unix socket the recorder serves and the agent connects to. Unset
# uses the in-container default. Set it to an empty string to bypass the
# recorder and call the upstream directly, which is only useful outside Docker.
# Compose deliberately passes this to neither service, so setting it here does
# nothing to the stack: an operator cannot empty it and route the agent around
# the recorder. It applies only when running the agent on a bare host.
#LLM_SOCKET_PATH=/llm/sock/core.sock

# Reasoning effort sent with each request: none, low, medium, or high.
# Leave unset to omit the field and let the model apply its own default.
# Models that do not support the field may reject requests that carry it.
#REASONING_EFFORT=high

# Operator console token for the stage (required to use the console on :8092)
STAGE_CONSOLE_TOKEN=

# Optional narrative recap on the stream page. The stage calls an
# OpenAI-compatible chat-completions endpoint to summarise recent
# incarnations in prose. Leave STAGE_SUMMARY_API_KEY empty to disable the
# feature; it is off by default and the page then derives its recap from
# tombstone text. This key is separate from OPENROUTER_API_KEY: the stage
# never reads the recorder's credential.
STAGE_SUMMARY_API_KEY=
#STAGE_SUMMARY_BASE_URL=https://openrouter.ai/api/v1
#STAGE_SUMMARY_MODEL=anthropic/claude-sonnet-5
#STAGE_SUMMARY_INTERVAL_SECONDS=300
#STAGE_COMMENTARY_MODEL=anthropic/claude-haiku-4-5-20251001
#STAGE_COMMENTARY_INTERVAL_SECONDS=60

# Optional speech for the diode's `speak` command. This key is mounted ONLY
# into the diode container, never the agent: the agent has no network
# interface, and reaches the diode only through a shared volume carrying a
# closed command vocabulary, so it can cause spend through the gated, budgeted
# command but never sees the key. Leave empty to disable the command entirely.
ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
#ELEVENLABS_MODEL=eleven_multilingual_v2

# Both controls on this credential's spend. The agent can write the diode's
# console file, so neither the on-switch nor the ceiling may live there:
# ENABLE_SPEECH (any non-empty value) has to be set before `speak` can exist,
# and SPEECH_HOURLY_MAX caps how many utterances an hour can produce no matter
# what fetch_budget the agent sets. Default ceiling is 20.
ENABLE_SPEECH=
#SPEECH_HOURLY_MAX=20

# Ceiling on the diode's shared hourly network-operation budget. The agent can
# write the console's fetch_budget, so the ceiling lives here: the effective
# limit at every budget-charging command is min(fetch_budget, DIODE_HOURLY_MAX),
# and speak additionally respects SPEECH_HOURLY_MAX. Default ceiling is 120.
#DIODE_HOURLY_MAX=120

# Ceiling on any single declared model stream's hourly request allowance. The
# agent declares streams (and their budgets) in the llm console file it can
# write, so the ceiling lives here instead: whatever budget a declaration
# names, min(budget, STREAM_HOURLY_MAX) is enforced. Default ceiling is 120.
#STREAM_HOURLY_MAX=120

# Model identifiers a declared stream may set as its composed model, as a
# comma-separated list matched exactly. Empty permits none: a declaration that
# names a model is rejected, and requests keep the model they were sent with.
# The permitted list is published to the agent as /llm/sock/models.json.
#STREAM_MODEL_ALLOW=deepseek/deepseek-v4-pro,qwen/qwen2.5-vl-7b-instruct

# Cloudflare Tunnel token for the optional cloudflared service
# (docker compose --profile stream up). Point the tunnel's public hostname
# at http://stage:8091. Never expose 8092.
TUNNEL_TOKEN=
