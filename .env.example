# The recorder forwards to one of two upstreams. Setting LLM_BASE_URL selects
# the OpenAI-compatible mode; leaving it unset selects OpenRouter.

# --- Mode 1: OpenRouter ---
# Real key — mounted ONLY into the recorder container, never the agent.
OPENROUTER_API_KEY=sk-or-...
# Model the agent requests (forwarded by the recorder).
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# --- Mode 2: OpenAI-compatible router ---
# A server bound to 0.0.0.0:5000 on the Docker host is reachable from the
# recorder container as host.docker.internal:5000. For runs outside Docker,
# use http://localhost:5000/v1.
#LLM_BASE_URL=http://host.docker.internal:5000/v1
# Optional key for the upstream server. Leave empty for a no-auth local server.
#LLM_API_KEY=
# Model name sent in chat completion requests. Overrides OPENROUTER_MODEL.
#LLM_MODEL=local-model

# Send-time context window in estimated tokens. Set this below the upstream
# server's context length so Aurora's windowing decides what is dropped.
#CONTEXT_WINDOW_TOKENS=28000

# Operator console token for the stage (required to use the console on :8092)
STAGE_CONSOLE_TOKEN=

# Cloudflare Tunnel token for the optional cloudflared service
# (docker compose --profile stream up). Point the tunnel's public hostname
# at http://stage:8091. Never expose 8092.
TUNNEL_TOKEN=
