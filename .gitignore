# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local editor / agent settings
.claude/settings.local.json

# Secrets — the real key lives only in the recorder's env
.env

# Build artifact (regenerated by scripts/build_garden.py)
garden_export/

# Runtime state — regenerated each run or written by the agent
session_context.json
agent_life_transcript.jsonl
agent_life_transcript.txt
tombstones/
.playwright-mcp/

# Filigree issue tracker — its config travels with the repo, its database does
# not: a binary sqlite file conflicts on every concurrent edit and grows the
# history without being reviewable. Ignoring .weft/ itself would stop git
# descending, and the nested .weft/filigree/.gitignore that keeps the ephemeral
# runtime files (WAL sidecars, logs, pids, federation_token) out would never be
# read.
.weft/*
!.weft/filigree/
.weft/filigree/filigree.db
.filigree/

# Operator-provisioned volumes and locally built wheels
volumes/
vendor/wheels/

# Claude worktrees and local captures
.claude/worktrees/
*.png

books/*
!books/.gitkeep
